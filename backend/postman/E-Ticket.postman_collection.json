{
  "info": {
    "name": "E-Ticket API",
    "description": "Cookie sessions + CSRF. Run \"Login (admin)\" or \"Login (attendee)\" first: its test script stores the CSRF token in {{csrf}} and Postman keeps the session cookie. Fill ticketId / reservationId / eventId / attendeeId / ticketCode collection variables from earlier responses. Roles share one cookie jar, so log in as the role you want before each folder. The \"Password reset & change\" folder is self-contained (it logs in as admin itself); login is rate-limited: 5 wrong passwords for one email from one IP in 15 minutes -> 429.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000/api"
    },
    {
      "key": "csrf",
      "value": ""
    },
    {
      "key": "eventId",
      "value": "1"
    },
    {
      "key": "ticketId",
      "value": "1"
    },
    {
      "key": "reservationId",
      "value": "1"
    },
    {
      "key": "attendeeId",
      "value": "1"
    },
    {
      "key": "userId",
      "value": "2"
    },
    {
      "key": "ticketCode",
      "value": ""
    },
    {
      "key": "resetUserId",
      "value": ""
    },
    {
      "key": "resetCode",
      "value": ""
    }
  ],
