      "name": "Auth",
      "item": [
        {
          "name": "Register (attendee only)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.csrf) pm.collectionVariables.set(\"csrf\", j.csrf);",
                  "pm.test(\"status is 200/201\", () => pm.expect([200, 201]).to.include(pm.response.code));",
                  "pm.test(\"role is forced to attendee\", () => pm.expect(pm.response.json().user.role).to.eql(\"attendee\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrf}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_Name\": \"New Attendee\",\n  \"email\": \"new@eticket.test\",\n  \"password\": \"secret123\",\n  \"role\": \"admin\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            }
          }
        },
