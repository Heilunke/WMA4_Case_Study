      "item": [
        {
          "name": "Create event",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrf}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_name\": \"Postman Night\",\n  \"category\": \"Concert\",\n  \"event_date\": \"2026-12-31\",\n  \"event_time\": \"19:00\",\n  \"venue\": \"TSU Hall\",\n  \"description\": \"Created from Postman\",\n  \"ticket_types\": [\n    {\n      \"type_name\": \"Regular\",\n      \"price\": 100,\n      \"total\": 50\n    }\n  ]\n}",
              "options": {
                "raw": {
