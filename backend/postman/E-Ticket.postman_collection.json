        {
          "name": "Issue password reset code (admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const j2 = pm.response.json();",
                  "pm.test(\"10-character code with an expiry\", () => { pm.expect(j2.code).to.match(/^[A-Z2-9]{10}$/); pm.expect(j2.expires_at).to.be.a(\"string\"); });",
                  "pm.collectionVariables.set(\"resetCode\", j2.code);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
